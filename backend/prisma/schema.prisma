generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  description String
  category    String
  barcode     String   @unique
  imageUrl    String
  createdAt   DateTime @default(now())
}
